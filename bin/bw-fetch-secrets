#!/usr/bin/env bash
#
# bw-fetch-secrets — Fetch secrets from Bitwarden vault and cache as env vars.
#
# Usage:
#   bw-fetch-secrets          # fetch and write cache
#   bw-fetch-secrets --check  # exit 0 if cache exists and is <24h old
#
set -euo pipefail

CACHE_FILE="${HOME}/.cache/bw-env"
CACHE_DIR="${HOME}/.cache"
ITEM_NAME="Shell Secrets"
KEYCHAIN_SERVICE="bw-master-password"
KEYCHAIN_ACCOUNT="$(whoami)"
MAX_AGE_SECONDS=86400 # 24 hours

die() { echo "ERROR: $*" >&2; exit 1; }

check_cache_freshness() {
  [[ -f "$CACHE_FILE" ]] || return 1
  local now file_mod age
  now=$(date +%s)
  file_mod=$(stat -f %m "$CACHE_FILE")
  age=$(( now - file_mod ))
  (( age < MAX_AGE_SECONDS ))
}

get_master_password() {
  security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null \
    || die "Cannot retrieve master password from Keychain. Run:\n  security add-generic-password -a \"\$(whoami)\" -s \"$KEYCHAIN_SERVICE\" -w -U"
}

fetch_and_cache() {
  local master_pw session item fields

  echo "Fetching secrets from Bitwarden..."

  export BW_MASTER_PW
  BW_MASTER_PW=$(get_master_password)

  bw login --check >/dev/null 2>&1 \
    || die "Not logged in to Bitwarden. Run: bw login"

  session=$(bw unlock --passwordenv BW_MASTER_PW --raw 2>/dev/null) \
    || die "Failed to unlock vault. Is the master password in Keychain correct?"
  unset BW_MASTER_PW

  BW_SESSION="$session" bw sync >/dev/null 2>&1 || true

  item=$(BW_SESSION="$session" bw get item "$ITEM_NAME" 2>/dev/null) \
    || die "Cannot find item '$ITEM_NAME' in vault."

  fields=$(echo "$item" | jq -r '.fields[] | "export " + .name + "=" + (.value | @sh)') \
    || die "Failed to parse fields from '$ITEM_NAME'."

  [[ -n "$fields" ]] || die "No fields found in '$ITEM_NAME'."

  mkdir -p "$CACHE_DIR"
  {
    echo "# Auto-generated by bw-fetch-secrets — $(date -Iseconds)"
    echo "# DO NOT EDIT — re-run: bw-fetch-secrets"
    echo "$fields"
  } > "$CACHE_FILE"
  chmod 600 "$CACHE_FILE"

  BW_SESSION="$session" bw lock >/dev/null 2>&1 || true

  # Regenerate Raycast config from cached token
  local raycast_token
  raycast_token=$(echo "$item" | jq -r '.fields[] | select(.name == "RAYCAST_TOKEN") | .value // empty')
  if [[ -n "$raycast_token" ]]; then
    local raycast_config="${HOME}/.config/raycast/config.json"
    mkdir -p "$(dirname "$raycast_config")"
    jq -n --arg t "$raycast_token" '{"accesstoken": $t, "token": $t}' > "$raycast_config"
    chmod 600 "$raycast_config"
    echo "Raycast config updated."
  fi

  echo "Secrets cached to $CACHE_FILE ($(echo "$fields" | wc -l | tr -d ' ') vars)"
}

if [[ "${1:-}" == "--check" ]]; then
  if check_cache_freshness; then
    echo "Cache is fresh."
    exit 0
  else
    echo "Cache is stale or missing."
    exit 1
  fi
fi

fetch_and_cache
